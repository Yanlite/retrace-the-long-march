{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "app/page.tsx",
    "components/march-map.tsx",
    "lib/engine.mjs",
    "lib/history.mjs",
    "lib/timeline.mjs",
    "lib/event-layout.mjs",
    "lib/event-places.mjs",
    "pages/**/*.tsx",
    "vite.pages.config.ts"
  ]
}